# SA Cloud demo configuration. Copy to .env; never commit the populated file.
# Keep secrets in 1Password. Replace these example op:// references with yours.
# Load AND resolve this file explicitly:
#   op run --env-file=.env -- ./scripts/sa-demo <command>
# Or export resolved variables through your existing credential manager and run
# ./scripts/sa-demo directly. No launcher implicitly reads or sources .env.

# ClickHouse-managed Postgres: use the direct endpoint, not a transaction pooler.
# Store the full libpq connection string in 1Password. Example structure:
# host=your-pg-host port=5432 dbname=postgres user=your-user password=... sslmode=verify-full sslrootcert=/absolute/path/postgres-ca.pem
DATABASE_URL=op://your-vault/daylight-postgres/connection-string

# ClickHouse Cloud HTTPS endpoint (hostname only, without https://).
CLICKHOUSE_HOST=your-service.us-west-2.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=op://your-vault/daylight-clickhouse/password

# The SA launcher enforces Cloud mode, local MiniLM embedding enrichment and
# the synthetic sample profile. No separate embedding API key is needed.
HEALTH_CLOUD=1
HEALTH_AI_EMBED=0
HEALTH_USER_ID=demo-alex

# Live model: select an OpenAI Responses-compatible model available to you.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=replace-with-your-model
AGENT_API_STYLE=responses
AGENT_REASONING_EFFORT=low
AGENT_API_KEY=op://your-vault/daylight-model/credential

# Langfuse project keys and the correct region / self-hosted instance URL.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=op://your-vault/daylight-langfuse/public-key
LANGFUSE_SECRET_KEY=op://your-vault/daylight-langfuse/secret-key
LANGFUSE_TRACING_ENABLED=true
# Deliberately do not enable personal-data tracing in the sample SA handoff.
